# Copy to .env in the repository root. Never commit the copy.
# Read by `docker compose` and by the backend. Backend settings use the APP_ prefix;
# ${VAR} references are expanded by both.

# Platform database (compose service `postgres`, host port 5433).
# Choose any value; the URLs below reuse it.
POSTGRES_PASSWORD=change-me
APP_DATABASE_URL=postgresql+psycopg://incidents:${POSTGRES_PASSWORD}@localhost:5433/incidents
# Backend tests create and truncate tables here, never in the main database.
APP_TEST_DATABASE_URL=postgresql+psycopg://incidents:${POSTGRES_PASSWORD}@localhost:5433/incidents_test

APP_SERVICE_NAME=incident-intelligence-api
# One of: local, test, staging, production
APP_ENVIRONMENT=local

# Observability backends (defaults match the local demo stack):
# APP_PROMETHEUS_URL=http://localhost:9090
# APP_JAEGER_URL=http://localhost:16686
# APP_OPENSEARCH_URL=http://localhost:9200
# APP_LOGS_INDEX=otel-logs
# APP_DEPLOY_EVENTS_INDEX=deploy-events
# APP_BACKEND_TIMEOUT_S=10
# APP_READINESS_TIMEOUT_S=2

# Investigation agent (Claude API). Create the key in a Console workspace that has a
# monthly spend limit. Without it, diagnosis endpoints return 503.
# ANTHROPIC_API_KEY=
# APP_LLM_MODEL=claude-opus-5-5
# APP_LLM_EFFORT=medium
# APP_LLM_MAX_TOKENS=16000
# APP_LLM_FALLBACKS=true
# APP_LLM_DAILY_BUDGET_USD=2

# Demo traffic rate:
# LOADGEN_RPS=2
