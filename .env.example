# Copy to backend/.env (or export in your shell). Never commit real values.
# All backend settings use the APP_ prefix.

APP_SERVICE_NAME=incident-intelligence-api
# One of: local, test, staging, production
APP_ENVIRONMENT=local

# Observability backends (defaults match the local demo stack):
# APP_PROMETHEUS_URL=http://localhost:9090
# APP_JAEGER_URL=http://localhost:16686
# APP_OPENSEARCH_URL=http://localhost:9200
# APP_LOGS_INDEX=otel-logs
# APP_DEPLOY_EVENTS_INDEX=deploy-events
# APP_BACKEND_TIMEOUT_S=10
# APP_READINESS_TIMEOUT_S=2

# Planned for later milestones (not used yet):
# APP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/incidents
# APP_LLM_API_KEY=

# Demo stack (read by `docker compose` from a .env file in the repo root):
# LOADGEN_RPS=2
