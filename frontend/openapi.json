                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Window end; defaults to now.",
              "title": "End"
            }
          },
          {
            "description": "Limit to these services; repeatable.",
            "in": "query",
            "name": "service",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Limit to these services; repeatable.",
              "title": "Service"
