        "title": "TimeWindow",
        "type": "object"
      },
      "TimelineEntry": {
        "properties": {
          "event": {
            "title": "Event",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "time": {
            "description": "ISO 8601 timestamp taken from the evidence.",
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "time",
          "event",
          "evidence_ids"
        ],
        "title": "TimelineEntry",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
