{
  "components": {
    "schemas": {
      "BudgetRead": {
        "description": "Today's diagnosis budget (UTC day).",
        "properties": {
          "day": {
            "description": "UTC date, YYYY-MM-DD.",
            "title": "Day",
            "type": "string"
          },
          "enabled": {
            "description": "False when no model is configured.",
            "title": "Enabled",
            "type": "boolean"
          },
          "limit_usd": {
            "title": "Limit Usd",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "remaining_usd": {
            "title": "Remaining Usd",
            "type": "string"
          },
          "spent_usd": {
            "description": "Spent or reserved by diagnoses today.",
            "title": "Spent Usd",
            "type": "string"
          },
          "typical_cost_usd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Median cost of the last 20 completed diagnoses; null before any.",
            "title": "Typical Cost Usd"
          }
        },
        "required": [
          "day",
          "limit_usd",
          "spent_usd",
          "remaining_usd",
          "typical_cost_usd",
          "enabled",
          "model"
        ],
        "title": "BudgetRead",
        "type": "object"
      },
      "CitedClaim": {
        "properties": {
          "evidence_ids": {
            "description": "IDs of the evidence supporting the claim.",
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "statement": {
            "description": "One factual claim, stated plainly.",
            "title": "Statement",
            "type": "string"
          }
        },
        "required": [
          "statement",
          "evidence_ids"
        ],
        "title": "CitedClaim",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "DiagnosisBrief": {
        "description": "The newest diagnosis of an incident, for lists and headers.",
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "root_cause_service": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when there is no root cause.",
            "title": "Root Cause Service"
          },
          "snapshot_id": {
            "format": "uuid",
            "title": "Snapshot Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DiagnosisStatus"
          }
        },
        "required": [
          "id",
          "snapshot_id",
          "status",
          "created_at",
          "root_cause_service",
          "confidence"
        ],
        "title": "DiagnosisBrief",
        "type": "object"
      },
      "DiagnosisOutput": {
        "properties": {
          "contributing_factors": {
            "items": {
              "$ref": "#/components/schemas/CitedClaim"
            },
            "title": "Contributing Factors",
            "type": "array"
          },
          "recommended_actions": {
            "items": {
              "$ref": "#/components/schemas/RecommendedAction"
            },
            "title": "Recommended Actions",
            "type": "array"
          },
          "root_cause": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RootCause"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the evidence does not support any root cause."
          },
          "ruled_out": {
            "description": "Plausible causes the evidence argues against.",
            "items": {
              "$ref": "#/components/schemas/CitedClaim"
            },
            "title": "Ruled Out",
            "type": "array"
          },
          "summary": {
            "description": "Two or three sentences for an on-call engineer.",
            "title": "Summary",
            "type": "string"
          },
          "timeline": {
            "description": "Ordered by time.",
            "items": {
              "$ref": "#/components/schemas/TimelineEntry"
            },
            "title": "Timeline",
            "type": "array"
          },
          "unknowns": {
            "description": "Open questions and evidence that is missing or would change the conclusion.",
            "items": {
              "type": "string"
            },
            "title": "Unknowns",
            "type": "array"
          }
        },
        "required": [
          "summary",
          "root_cause",
          "contributing_factors",
          "timeline",
          "ruled_out",
          "unknowns",
          "recommended_actions"
        ],
        "title": "DiagnosisOutput",
        "type": "object"
      },
      "DiagnosisRead": {
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "effort": {
            "title": "Effort",
            "type": "string"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "fallback_used": {
            "title": "Fallback Used",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "model_requested": {
            "title": "Model Requested",
            "type": "string"
          },
          "model_used": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Used"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosisOutput"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "prompt_version": {
            "title": "Prompt Version",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "snapshot_id": {
            "format": "uuid",
            "title": "Snapshot Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DiagnosisStatus"
          },
          "stop_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          },
          "validation_errors": {
            "items": {
              "type": "string"
            },
            "title": "Validation Errors",
            "type": "array"
          }
        },
        "required": [
          "id",
          "snapshot_id",
          "status",
          "created_at",
          "completed_at",
          "model_requested",
          "model_used",
          "effort",
          "prompt_version",
          "output",
          "validation_errors",
          "error_message",
          "stop_reason",
          "fallback_used",
          "input_tokens",
          "output_tokens",
          "cost_usd",
          "request_id"
        ],
        "title": "DiagnosisRead",
        "type": "object"
      },
      "DiagnosisStatus": {
        "enum": [
          "running",
          "valid",
          "invalid",
          "refused",
          "error"
        ],
        "title": "DiagnosisStatus",
        "type": "string"
      },
      "Evidence": {
        "description": "One citable observation, traceable back to the exact query that produced it.",
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "id": {
            "description": "Stable ID: same source, kind, key, and window give the same ID.",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "description": "What the observation is, e.g. 'log_pattern'.",
            "title": "Kind",
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the observed behaviour started, if known.",
            "title": "Observed At"
          },
          "query": {
            "description": "The backend query that produced this evidence.",
            "title": "Query",
            "type": "string"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URL to inspect the raw data.",
            "title": "Reference"
          },
          "service": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service"
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource"
          },
          "summary": {
            "description": "Factual one-line description, derived only from `data`.",
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "kind",
          "summary",
          "query"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "EvidenceBundle": {
        "properties": {
          "collected_at": {
            "format": "date-time",
            "title": "Collected At",
            "type": "string"
          },
          "errors": {
            "description": "Sources that could not be queried. Their evidence is missing, not empty.",
            "items": {
              "$ref": "#/components/schemas/SourceError"
            },
            "title": "Errors",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "services": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Services requested; null means all.",
            "title": "Services"
          },
          "window": {
            "$ref": "#/components/schemas/TimeWindow"
          }
        },
        "required": [
          "window",
          "services",
          "collected_at",
          "evidence",
          "errors"
        ],
        "title": "EvidenceBundle",
        "type": "object"
      },
      "EvidenceSource": {
        "enum": [
          "metrics",
          "traces",
          "logs",
          "deployments"
        ],
        "title": "EvidenceSource",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IncidentCreate": {
        "properties": {
          "collect_evidence": {
            "default": true,
            "description": "Collect and store an evidence snapshot on creation.",
            "title": "Collect Evidence",
            "type": "boolean"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "services": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Services in scope; null means all.",
            "title": "Services"
          },
          "severity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Severity"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "window": {
            "$ref": "#/components/schemas/TimeWindow"
          }
        },
        "required": [
          "title",
          "window"
        ],
        "title": "IncidentCreate",
        "type": "object"
      },
      "IncidentPage": {
        "properties": {
          "items": {
